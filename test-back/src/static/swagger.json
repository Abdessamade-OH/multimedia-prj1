{
    "openapi": "3.0.0",
    "info": {
      "title": "Image and 3D Model Search API",
      "version": "1.0.0",
      "description": "API for image processing, feature extraction, and 3D model search"
    },
    "paths": {
      "/extract_features/{image_name}": {
        "post": {
          "summary": "Extract features from an image",
          "description": "Extract features from a specific image and find similar images using cached features",
          "parameters": [
            {
              "name": "image_name",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string"
              },
              "description": "Name of the image file"
            }
          ],
          "requestBody": {
            "content": {
              "application/x-www-form-urlencoded": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "category": {
                      "type": "string",
                      "enum": ["aGrass", "bField", "cIndustry", "dRiverLake", "eForest", "fResident", "gParking"],
                      "description": "Image category"
                    },
                    "k": {
                      "type": "integer",
                      "default": 10,
                      "description": "Number of similar images to return"
                    }
                  },
                  "required": ["category"]
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Features extracted successfully",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "status": {
                        "type": "string"
                      },
                      "image_name": {
                        "type": "string"
                      },
                      "features": {
                        "type": "object"
                      },
                      "query_image_url": {
                        "type": "string"
                      },
                      "similar_images": {
                        "type": "array",
                        "items": {
                          "type": "object"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "/transform/{image_name}": {
        "post": {
          "summary": "Transform an image",
          "description": "Apply various transformations to an image",
          "parameters": [
            {
              "name": "image_name",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "category",
              "in": "query",
              "schema": {
                "type": "string"
              },
              "description": "Image category"
            }
          ],
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "transformations": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": ["crop", "resize", "rotate"]
                      }
                    },
                    "crop_coordinates": {
                      "type": "object",
                      "properties": {
                        "x": {"type": "integer"},
                        "y": {"type": "integer"},
                        "width": {"type": "integer"},
                        "height": {"type": "integer"}
                      }
                    },
                    "resize_dimensions": {
                      "type": "object",
                      "properties": {
                        "width": {"type": "integer"},
                        "height": {"type": "integer"}
                      }
                    },
                    "rotation_angle": {
                      "type": "number"
                    }
                  },
                  "required": ["transformations"]
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Image transformed successfully",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "status": {"type": "string"},
                      "transformed_image_url": {"type": "string"},
                      "transformation_details": {"type": "object"}
                    }
                  }
                }
              }
            }
          }
        }
      },
      "/relevance-feedback-search": {
        "post": {
          "summary": "Search with relevance feedback",
          "description": "Process image search using Query Point Movement (QPM) relevance feedback method",
          "parameters": [
            {
              "name": "k",
              "in": "query",
              "schema": {
                "type": "integer",
                "default": 10
              },
              "description": "Number of results to return"
            }
          ],
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Image name"
                    },
                    "category": {
                      "type": "string",
                      "enum": ["aGrass", "bField", "cIndustry", "dRiverLake", "eForest", "fResident", "gParking"]
                    },
                    "relevant_images": {
                      "type": "array",
                      "items": {"type": "string"}
                    },
                    "non_relevant_images": {
                      "type": "array",
                      "items": {"type": "string"}
                    },
                    "alpha": {
                      "type": "number",
                      "default": 1.0
                    },
                    "beta": {
                      "type": "number",
                      "default": 0.65
                    },
                    "gamma": {
                      "type": "number",
                      "default": 0.35
                    }
                  },
                  "required": ["name", "category"]
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Search completed successfully",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "status": {"type": "string"},
                      "similar_images": {"type": "array"},
                      "feedback_applied": {"type": "boolean"}
                    }
                  }
                }
              }
            }
          }
        }
      },
      "/search_3d_model": {
        "post": {
          "summary": "Search for similar 3D models",
          "description": "Upload a 3D model and find similar models in the database",
          "requestBody": {
            "content": {
              "multipart/form-data": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "model": {
                      "type": "string",
                      "format": "binary",
                      "description": "3D model file (OBJ format)"
                    },
                    "n_results": {
                      "type": "integer",
                      "default": 5,
                      "description": "Number of results to return"
                    }
                  },
                  "required": ["model"]
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Search completed successfully",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "results": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "thumbnail_path": {"type": "string"},
                            "similarity": {"type": "number"},
                            "category": {"type": "string"}
                          }
                        }
                      },
                      "query_descriptors": {"type": "object"}
                    }
                  }
                }
              }
            }
          }
        }
      },
      "/compare_3d_search": {
        "post": {
          "summary": "Comparative search for 3D models",
          "description": "Upload a 3D model and perform comparative analysis with different reduction methods",
          "requestBody": {
            "content": {
              "multipart/form-data": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "model": {
                      "type": "string",
                      "format": "binary",
                      "description": "3D model file (OBJ format)"
                    },
                    "n_results": {
                      "type": "integer",
                      "default": 5,
                      "description": "Number of results to return"
                    },
                    "reduction_method": {
                      "type": "string",
                      "enum": ["vertex_clustering", "edge_collapse"],
                      "default": "vertex_clustering",
                      "description": "Method used for mesh reduction"
                    }
                  },
                  "required": ["model"]
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Comparative analysis completed successfully",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "comparative_results": {"type": "object"},
                      "reduction_method": {"type": "string"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }